#!name=VibeHeader（请求头管理器）
#!desc=像 Chrome 的 VibeHeader 插件一样，按域名 / 路径对请求头做增加、覆盖、删除。配置在 BoxJs 里，支持多规则、逐条启用与域名范围限定。自检页：http://vibeheader.com/
#!author=Sharpe-x
#!homepage=https://github.com/Sharpe-x/vibe-header
#!category=BoxJs

# =============================================================================
# VibeHeader for Surge
#   配置：BoxJs（导入 boxjs.vibeheader.json，或手动添加 8 个键）
#   自检：浏览器打开 http://vibeheader.com/
#         （备用入口 http://vibeheader.test/ 与 http://192.0.2.1/，三个都指向同一页面）
#
# ⚠️ 使用前必读两条硬性前提
#   1) HTTPS 请求必须先被 MITM 解密，脚本才能看到它 —— 见文末 [MITM]
#   2) Surge 对每个请求只会运行「一个」http-request 脚本（先匹配到的胜出）。
#      下面 pattern 写成 ^https?:// 时，本模块会抢占 Cookie 抓取 / 其他重写脚本。
#      如果你还装了那类脚本，请把 pattern 收窄到目标域名，例如：
#        pattern=^https?://([^/]+\.)?(example\.com|foo\.com)/
# =============================================================================

[Host]
# 让自检页的「假域名」一定能被解析出来 —— 这是整条链路的第一道门槛：
#   客户端必须能解析出 IP，才会有 TCP 连接；有连接 Surge 才能嗅探到它是明文 HTTP、
#   交给 HTTP 引擎、进而交给 VibeHeader 脚本应答。
# 这里直接由 Surge 给出解析结果，因此**不依赖真实 DNS**（对方换 IP、被污染、被墙都不影响）。
# 192.0.2.0/24 是 RFC 5737 保留的测试网段，公网上不存在真实主机，请求不会真的发出去。
# 与 BoxJs 用 http://boxjs.com 是同一套机制（BoxJs 只靠 force-http-engine-hosts；
# 我们额外加了这层映射，比它更稳）。
vibeheader.com = 192.0.2.1
www.vibeheader.com = 192.0.2.1
vibeheader.test = 192.0.2.1
vibeheader.local = 192.0.2.1

[General]
# 允许 http / https 的自检页都走 Surge 的 HTTP 引擎（BoxJs 模块里的同款写法）。
# 说明：明文 HTTP 的 80 端口本来就会被 Surge 自动嗅探，这行主要是为 https:// 自检页兜底。
force-http-engine-hosts = %APPEND% vibeheader.com, www.vibeheader.com, vibeheader.test, vibeheader.local, 192.0.2.1

[Script]
# 脚本地址二选一（国内若 raw 域名不通，把下面两行的地址换成 jsDelivr 那版即可）：
#   raw      https://raw.githubusercontent.com/Sharpe-x/vibe-header/main/vibe-header.js
#   jsDelivr https://cdn.jsdelivr.net/gh/Sharpe-x/vibe-header@main/vibe-header.js

# ① 主脚本：按规则改请求头（同时负责应答自检页）
VibeHeader = type=http-request,pattern=^https?://,script-path=https://raw.githubusercontent.com/Sharpe-x/vibe-header/main/vibe-header.js,requires-body=false

# ② 可选：每天 9 点自检一次配置，只在语法写错时发通知（不需要可直接删掉这行）
VibeHeaderSelfCheck = type=cron,cronexp="0 9 * * *",script-path=https://raw.githubusercontent.com/Sharpe-x/vibe-header/main/vibe-header.js,argument=check

# ③ 看状态（推荐，不依赖浏览器）：在 Surge 的「脚本」列表里长按 VibeHeaderStatus → 运行，
#    会弹一条通知，把总开关 / 规则条数 / 语法问题 / 最近命中一次列全。
#    若列表里找不到这条，改用「万能触发」：浏览器打开任意明文 http 网址，把路径写成 /vibeheader-status
VibeHeaderStatus = type=generic,script-path=https://raw.githubusercontent.com/Sharpe-x/vibe-header/main/vibe-header.js,argument=status

[MITM]
# ⚠️ 必改：只有写在这里的域名，其 HTTPS 请求才会被解密，规则才可能生效。
#    明文 http 请求不需要 MITM。多个域名用逗号分隔，支持 * 通配。
#
# 三个 vibeheader.* 是自检页自己的域名（保留不动，让 https 方式访问自检页也能应答）；
# example.com 只是占位符 —— 请替换成你真正要改请求头的域名，例如：
#   hostname = %APPEND% vibeheader.com, *.ess.tencent.cn, *.qian.tencent.com, *.qian.tencent.cn
hostname = %APPEND% vibeheader.com, www.vibeheader.com, vibeheader.test, vibeheader.local, example.com
#
# 方案 B（谨慎）：让规则对「所有域名」生效 —— 先注释掉上面那行，再启用下面这行。
#    这会解密全部 HTTPS 流量；使用证书固定（pinning）的 App 可能因此无法联网。
# hostname = %APPEND% -*.apple.com, -*.icloud.com, -*.mzstatic.com, -*.crashlytics.com, *
